super + Return
	alacritty

super + s
	alacritty -e btop

super + f
	alacritty -e nnn -Rr

super + c
	rofi -show calc -no-show-match -no-sort

super + shift + c
	qalculate-gtk

super + t
	clipmenu

super + shift + p
	mpv "$(xclipc -o)"

super + e
	thunar

super + shift + w
  librewolf	

super + alt + z
	/home/najib/script/exit.sh

super + d
	/home/najib/script/edit_config.sh

super + equal
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+ && kill -10 $(pidof dwmblocks)

super + minus
  wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%- && kill -10 $(pidof dwmblocks)

super + BackSpace
  wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && kill -10 $(pidof dwmblocks)

shift + alt + 0
	xrandr --output VGA-0 --gamma 1.0:1.0:1.0 --brightness 1.0

shift + alt + 1
	xrandr --output VGA-0 --gamma 1.0:0.95:0.8 --brightness 0.9

shift + alt + 2
	xrandr --output VGA-0 --gamma 1.0:0.85:0.7 --brightness 0.8

shift + alt + 3
	xrandr --output VGA-0 --gamma 1.0:0.75:0.55 --brightness 0.7

shift + alt + 4
	xrandr --output VGA-0 --gamma 1.0:0.6:0.35 --brightness 0.5

super + r
	dmenu_run

super + shift + e
	bemoji

super + Escape
	xkill

Print
	flameshot gui

super + w
	pkill -USR1 -x sxhkd

super + z
	systemctl suspend

